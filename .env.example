# Optional overrides for local development.
# Cloned desktop builds hit production by default (see src/shared/api.ts).

# Point the Electron app at a local KERN API instead of production:
# KERN_API_URL=http://127.0.0.1:4000

# Never put real BharatCode keys or JWT secrets in git.
# Store the BharatCode API key in the app Settings UI (Electron safeStorage).
