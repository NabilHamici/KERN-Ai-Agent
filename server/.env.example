NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string (never commit real credentials)
DATABASE_URL=postgres://kern:kern@127.0.0.1:5432/kern?sslmode=disable

# Public app / desktop deep-link base URL used in email templates
APP_URL=http://localhost:4000

# CORS allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP (required when EMAIL_DEV_MODE=false)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=KERN
SMTP_FROM_EMAIL=noreply@example.com

# When true, missing SMTP fails soft and emails are metadata-logged only
EMAIL_DEV_MODE=true

# Access-token signing secret (min 32 chars). Never commit real secrets.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OFFLINE_GRACE_DAYS=7
